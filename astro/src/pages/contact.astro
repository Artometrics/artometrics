---
import Base from "../layouts/Base.astro";
---

<Base title="Contact" description="Editorial tips, press, corrections, and partnerships for Artometrics." path="/contact">
  <article class="measure prose">
<p class="kicker">Contact</p>
<h1>Get in touch</h1>
<p>Editorial tips, dataset corrections, press, and partnership notes go to the Artometrics desk.</p>
<h2>Direct dispatch</h2>
<p>Email <a href="mailto:hello@artometrics.com">hello@artometrics.com</a>. The form opens your mail client so nothing is stored on this static host.</p>
<form class="form" action="mailto:hello@artometrics.com" method="post" enctype="text/plain">
  <label>Name <input name="name" autocomplete="name" /></label>
  <label>Email <input name="email" type="email" autocomplete="email" required /></label>
  <label>Note <textarea name="body" rows="5"></textarea></label>
  <button class="btn btn-pink" type="submit">Transmit dispatch</button>
</form>
<p><a href="/press">Press kit</a> · <a href="/legal/ethics-statement">Ethics</a></p>
  </article>
</Base>
