---
import Base from "../../layouts/Base.astro";
import { formatDate, getLegal, getLegalPages } from "../../lib/content";

export function getStaticPaths() {
  return getLegalPages().map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
---

<Base title={page.page} description={`${page.page} — Artometrics`} path={`/legal/${page.id}`}>
  <article class="measure prose">
    <p class="kicker">Legal · {formatDate(page.pubDate)}</p>
    <h1>{page.page}</h1>
    <div set:html={page.body} />
    <p class="chips">
      {getLegalPages().map((item) => <a class="chip" href={`/legal/${item.id}`}>{item.page}</a>)}
    </p>
  </article>
</Base>
