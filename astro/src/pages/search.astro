---
import Base from "../layouts/Base.astro";
import { getPosts } from "../lib/content";

const index = getPosts().map((post) => ({
  slug: post.slug,
  title: post.title,
  description: post.description,
  tags: (post.tags || []).join(" "),
}));
---

<Base title="Search" description="Search Artometrics reports." path="/search">
  <div class="measure prose">
    <p class="kicker">Index</p>
    <h1>Search</h1>
    <form class="search" action="/search" method="get" role="search">
      <label class="rule-label" for="q">Reports</label>
      <input id="q" name="q" type="search" placeholder="Franchise, Padres, anime…" autocomplete="off" />
    </form>
    <div id="results" class="list"></div>
    <noscript>
      <div class="list">
        {index.map((item) => <a href={`/${item.slug}`}><strong>{item.title}</strong></a>)}
      </div>
    </noscript>
  </div>
  <script id="search-index" type="application/json" set:html={JSON.stringify(index)} />
  <script is:inline>
    var data = JSON.parse(document.getElementById("search-index").textContent || "[]");
    var input = document.getElementById("q");
    var results = document.getElementById("results");
    function render(query) {
      var q = (query || "").trim().toLowerCase();
      var hits = data.filter(function (item) {
        if (!q) return true;
        return (item.title + " " + item.description + " " + item.tags).toLowerCase().indexOf(q) !== -1;
      }).slice(0, 40);
      results.replaceChildren();
      if (!hits.length) {
        var empty = document.createElement("p");
        empty.textContent = "No reports match.";
        results.appendChild(empty);
        return;
      }
      hits.forEach(function (item) {
        var link = document.createElement("a");
        link.href = "/" + item.slug;
        var title = document.createElement("strong");
        title.textContent = item.title;
        var deck = document.createElement("span");
        deck.className = "muted";
        deck.textContent = item.description;
        link.append(title, deck);
        results.appendChild(link);
      });
    }
    var params = new URLSearchParams(location.search);
    input.value = params.get("q") || "";
    render(input.value);
    input.addEventListener("input", function () { render(input.value); });
  </script>
</Base>
