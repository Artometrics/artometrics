---
import Base from "../../layouts/Base.astro";
import { TOOL_PAGES } from "../../lib/tools";

export function getStaticPaths() {
  return Object.keys(TOOL_PAGES).map((path) => ({ params: { path } }));
}

const key = Astro.params.path || "";
const page = TOOL_PAGES[key];
if (!page) throw new Error(`Missing tool page ${key}`);
---

<Base title={page.title} description={page.copy} path={`/tools/${key}`}>
  <article class="measure prose">
    <p class="kicker"><a href="/tools">Tools</a> · <a href="/studio">Studio</a></p>
    <h1>{page.title}</h1>
    <p>{page.copy}</p>
    <p>Signed-in files are not part of this static host. Use the member sign-in when the account service is connected, or write the desk.</p>
    <p><a class="btn btn-pink" href="/login">Sign in</a> <a class="btn btn-blue" href="/studio">Studio</a></p>
  </article>
</Base>
