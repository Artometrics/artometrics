# ── Public (Expo web + native) ────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SITE_URL=https://artometrics.com

# Optional analytics (GA4 Measurement ID, e.g. G-XXXXXXXX)
EXPO_PUBLIC_GA_ID=

# App Store / Play (filled after first release)
EXPO_PUBLIC_IOS_STORE_URL=
EXPO_PUBLIC_ANDROID_STORE_URL=
EXPO_PUBLIC_TESTFLIGHT_URL=

# Legacy aliases still read by lib/supabase/client.ts
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PUBLIC_SITE_URL=https://artometrics.com

# ── Netlify Functions only (never expose to client) ───────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (Dashboard → Products → copy price_… id)
STRIPE_PRICE_MONTHLY=price_...   # $4.99 / month
STRIPE_PRICE_ANNUAL=price_...    # $19.99 / year

# Optional: Netlify Forms / newsletter provider
# NEWSLETTER_FORM_NAME=artometrics-newsletter

# ── Media factory (local scripts / Netlify functions later) ───
# ElevenLabs long-form narration (npm run cos:narrate)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Notion editorial DB (Cursor Notion MCP uses its own OAuth; optional API)
NOTION_API_KEY=
NOTION_BRIEF_DATABASE_ID=
SLACK_WEBHOOK_URL=
GSC_SITE_URL=https://artometrics.com
GOOGLE_APPLICATION_CREDENTIALS=
BUFFER_PROFILE_IDS=

# Figma brand / print systems (Cursor Figma MCP uses OAuth; optional API)
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=

# Buffer social scheduling (when script lands)
BUFFER_ACCESS_TOKEN=

# Sanity (optional magazine CMS sync — see docs/SANITY_SETUP.md)
# Netlify Functions + Cursor Cloud secrets. Never put the write token in EXPO_PUBLIC_*.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
# Optional aliases for Studio / local
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=production
# Optional future client read (Expo still uses src/generated/* today)
# EXPO_PUBLIC_SANITY_PROJECT_ID=
# EXPO_PUBLIC_SANITY_DATASET=production

# Higgsfield is Cursor MCP-authenticated — no key in .env

# Twenty CRM (Local Open-Source CRM)
# TWENTY_CRM_URL=http://localhost:3000
# TWENTY_CRM_API_KEY=
# TWENTY_CRM_ARTOMETRICS_COMPANY_ID=
# EXPO_PUBLIC_TWENTY_CRM_URL=http://localhost:3000
