    {"id": "s10", "narration_text": "In twenty-twenty-four, nine of ten.", "type": "chart_beat", "chart_id": "chart7_top10_franchise_share", "on_screen_text": "9 of 10", "duration_s": 4},
    {"id": "s11", "narration_text": "Universal’s Dark Universe died after The Mummy.", "type": "ai_illustration", "ai_prompt": "stick-figure studio executive watching collapsing sand castle labeled 'shared universe', red and blue anaglyph palette, no real people", "duration_s": 4},
