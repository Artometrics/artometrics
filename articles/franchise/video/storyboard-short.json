    {"id": "s04", "narration_text": "Fifty-six percent of every dollar in the file sits in one bucket — merchandise, licensing, and retail.", "type": "chart_beat", "chart_id": "chart6_revenue_streams", "on_screen_text": "56% merchandise", "duration_s": 5},
