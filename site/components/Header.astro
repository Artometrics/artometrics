---
import { SITE_PRIMARY_NAV } from "@/lib/site-nav";
import { formatHeaderDate } from "@/lib/headerDateline";
import facts from "@/lib/nav-fun-facts.json";
import { LOGO_REVIEW, type LogoReviewMark, WORDMARKS } from "@/lib/wordmarks";
import { coverSrc } from "@/lib/article-assets.mjs";
import { jsonForScript } from "../lib/static-charts";

interface Props {
  variant?: "site" | "preview";
  logoReview?: LogoReviewMark;
}

const { variant = "site", logoReview } = Astro.props;
const preview = variant === "preview";
const review = logoReview ? LOGO_REVIEW[logoReview] : null;
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const reviewSection = /\/sources$/.test(path) ? "sources" : /\/mag$/.test(path) ? "mag" : "";
const dateline = formatHeaderDate();
const fact = facts[0];
const homeHref = review ? `/review/logos/${review.id}` : preview ? "/design-preview" : "/";

function reviewHref(id: LogoReviewMark) {
  return reviewSection ? `/review/logos/${id}/${reviewSection}` : `/review/logos/${id}`;
}

function navHref(href: string) {
  if (!preview) return href;
  if (href === "/blog") return "/design-preview#reports";
  if (href.startsWith("/topics/")) return `/design-preview${href}`;
  return href;
}

const catalogue = [
  ["pixar", "Pixar"],
  ["anime", "Anime"],
  ["franchise", "Franchise"],
  ["steam", "Steam"],
  ["dodgers", "Dodgers"],
  ["padres", "Padres"],
  ["celtics", "Celtics"],
  ["wine", "Wine"],
  ["coffee", "Coffee"],
  ["ramen", "Ramen"],
  ["nuclear", "Nuclear"],
  ["cetaceans", "Cetaceans"],
  ["longevity", "Longevity"],
  ["geopolitics", "Geopolitics"],
] as const;
const singles = [WORDMARKS.find((mark) => mark.id === "halftone")!, ...WORDMARKS.filter((mark) => mark.id !== "halftone")];

---

<header class="mast">
  <div class="dateline">{dateline}</div>
  <div class="wrap mast-row">
    <div class="mast-side">
      <button class="icon-btn" id="open-menu" type="button" aria-expanded="false" aria-controls="nav-overlay">
        <span class="sr" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Open menu</span>
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
    <a class="wordmark" href={homeHref} aria-label="Artometrics home">
      <span class="wordmark__plate">
        <img
          id="site-wordmark"
          alt=""
          src={review?.src ?? "/images/brand/wordmarks/wordmark-halftone.webp"}
          width={review?.width ?? 600}
          height={review?.height ?? 124}
          decoding="async"
          fetchpriority="high"
        />
      </span>
    </a>
    <div class="mast-side mast-side--end">
      <button
        class="icon-btn"
        id="appearance-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="appearance-panel"
        aria-label="Appearance"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 2.5a9.5 9.5 0 1 0 0 19 9.5 9.5 0 0 0 0-19zm0 2a7.5 7.5 0 0 1 0 15V4.5z"></path>
        </svg>
      </button>
    </div>
  </div>
  <script type="application/json" id="wordmark-catalog" set:html={jsonForScript(WORDMARKS)} />
  <script is:inline>
    (function () {
      var node = document.getElementById("wordmark-catalog");
      var catalog = node ? JSON.parse(node.textContent || "[]") : [];
      var root = document.documentElement;
      var key = root.getAttribute("data-logo") || "halftone";
      var hit = catalog[0];
      for (var i = 0; i < catalog.length; i++) if (catalog[i].id === key) hit = catalog[i];
      var img = document.getElementById("site-wordmark");
      var dark = root.getAttribute("data-theme") !== "light";
      var form = root.getAttribute("data-logo-form") || "single";
      if (img && hit && !root.getAttribute("data-logo-review")) {
        img.src = form === "wordmark" ? hit.src : (dark ? hit.appleNight : hit.appleDay);
      }
    })();
  </script>
  <div class="appearance" id="appearance-panel" hidden>
    <div class="wrap">
      <p class="appearance__label" id="appearance-mode-label">Color</p>
      <div class="appearance__modes" role="radiogroup" aria-labelledby="appearance-mode-label">
        <button type="button" role="radio" data-theme-choice="dark" aria-checked="true">Night</button>
        <button type="button" role="radio" data-theme-choice="light" aria-checked="false">Day</button>
      </div>
      <p class="appearance__label" id="appearance-logo-label">Logo</p>
      {review ? null : (
        <div class="appearance__form" role="radiogroup" aria-labelledby="appearance-logo-label">
          <button type="button" role="radio" data-logo-form-choice="single" aria-checked="true">Singles</button>
          <button type="button" role="radio" data-logo-form-choice="wordmark" aria-checked="false">Wordmarks</button>
        </div>
      )}
      {review ? (
        <div class="appearance__logos" role="navigation" aria-labelledby="appearance-logo-label">
          {(Object.keys(LOGO_REVIEW) as LogoReviewMark[]).map((id) => (
            <a href={reviewHref(id)} aria-current={id === review.id ? "true" : undefined} title={LOGO_REVIEW[id].file}>
              <img src={LOGO_REVIEW[id].src} alt={LOGO_REVIEW[id].label} width="120" height="28" />
            </a>
          ))}
        </div>
      ) : (
        <div class="appearance__singles" role="radiogroup" aria-label="Single A">
          {singles.map((mark) => (
            <button
              type="button"
              role="radio"
              data-logo-choice={mark.id}
              data-logo-kind="single"
              aria-checked={mark.id === "halftone" ? "true" : "false"}
              aria-label={mark.label}
              title={mark.label}
            >
              <img class="appearance__mono appearance__mono--night" src={mark.appleNight} alt="" width="180" height="180" />
              <img class="appearance__mono appearance__mono--day" src={mark.appleDay} alt="" width="180" height="180" />
            </button>
          ))}
        </div>
        <div class="appearance__wordmarks" role="radiogroup" aria-label="Wordmarks">
          {WORDMARKS.map((mark) => (
            <button
              type="button"
              role="radio"
              data-logo-choice={mark.id}
              data-logo-kind="wordmark"
              aria-checked="false"
              aria-label={mark.label}
              title={mark.label}
            >
              <img class="appearance__mark" src={mark.src} alt="" width="120" height="28" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>
  </div>
</header>

<div class="nav-overlay" id="nav-overlay" hidden>
  <div class="wrap">
    <div class="nav-overlay__bar">
      <button class="nav-overlay__side" id="close-menu" type="button">Close</button>
      <input id="nav-search" type="search" placeholder="Search" aria-label="Search reports and topics" autocomplete="off" />
      <button class="nav-overlay__side" id="nav-clear" type="button">Clear</button>
    </div>
    <div class="nav-overlay__scroll">
    <ul class="suggest" id="nav-suggest"></ul>
    <ul class="nav-list">
      {SITE_PRIMARY_NAV.map((item) => (
        <li>
          <a href={navHref(item.href)}>
            {item.label}
            {item.descriptor ? <span>{item.descriptor}</span> : null}
          </a>
        </li>
      ))}
      <li><a href="/podcast">Podcast <span>Interviews</span></a></li>
      <li><a href="/mag">Magazine <span>Page-flip edition</span></a></li>
      <li><a href="/studio">Studio</a></li>
      <li><a href="/contact">Dispatch</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/legal/ethics-statement">Legal</a></li>
      <li><a href="/sources">Sources</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
    <div class="nav-catalogue" aria-label="Catalogue">
      <p class="nav-catalogue__label">Catalogue</p>
      <div class="nav-catalogue__row" id="nav-catalogue-row" tabindex="0">
        {catalogue.map(([slug, title]) => (
          <div class="nav-catalogue__card">
            <a href={`/mag/${slug}`}>
              <img src={coverSrc(slug).src || `/images/content/articles/${slug}/cover.webp`} alt="" width="900" height="1200" />
              <span>{title}</span>
            </a>
          </div>
        ))}
      </div>
    </div>
    </div>
    <div class="fact">
      <p class="fact__label">Did you know?</p>
      <a class="fact__text" id="fact-link" href={fact ? `/${fact.slug}` : "/blog"} aria-label={fact ? `${fact.text}. ${fact.title}` : "Reports"}>
        {fact?.text}
      </a>
      <p>
        <a class="fact__source" id="fact-source" href={fact?.sourceHref || "/sources"}>
          {fact ? `Source · ${fact.sourceLabel}` : "Sources"}
        </a>
      </p>
    </div>
  </div>
</div>
<script type="application/json" id="nav-facts" set:html={jsonForScript(facts)} />
<script is:inline>
  (function () {
    var root = document.documentElement;
    var toggle = document.getElementById("appearance-toggle");
    var panel = document.getElementById("appearance-panel");
    var img = document.getElementById("site-wordmark");
    var catalogNode = document.getElementById("wordmark-catalog");
    var catalog = catalogNode ? JSON.parse(catalogNode.textContent || "[]") : [];

    function logoHit(id) {
      for (var i = 0; i < catalog.length; i++) if (catalog[i].id === id) return catalog[i];
      return null;
    }
    function logoSrc(id) {
      var hit = logoHit(id);
      if (!hit) return "";
      if (root.getAttribute("data-logo-form") === "wordmark") return hit.src;
      var dark = root.getAttribute("data-theme") !== "light";
      return dark ? hit.appleNight : hit.appleDay;
    }
    function paintForm(form, persist) {
      if (form !== "wordmark") form = "single";
      root.setAttribute("data-logo-form", form);
      var choices = document.querySelectorAll("[data-logo-form-choice]");
      for (var i = 0; i < choices.length; i++) {
        choices[i].setAttribute("aria-checked", choices[i].getAttribute("data-logo-form-choice") === form ? "true" : "false");
      }
      if (persist) {
        try { localStorage.setItem("artometrics-logo-form", form); } catch (e) {}
      }
    }
    function paintLogo(id, persist) {
      if (root.getAttribute("data-logo-review")) {
        id = root.getAttribute("data-logo") || id;
        persist = false;
      }
      if (!logoHit(id)) id = "halftone";
      var src = logoSrc(id);
      root.setAttribute("data-logo", id);
      if (img && src && !root.getAttribute("data-logo-review")) {
        if (img.getAttribute("src") !== src) img.setAttribute("src", src);
        var single = root.getAttribute("data-logo-form") === "single";
        img.setAttribute("width", single ? "180" : "600");
        img.setAttribute("height", single ? "180" : "124");
      }
      if (persist) {
        try { localStorage.setItem("artometrics-logo", id); } catch (e) {}
      }
      var logos = document.querySelectorAll("[data-logo-choice]");
      var form = root.getAttribute("data-logo-form") || "single";
      for (var i = 0; i < logos.length; i++) {
        var same = logos[i].getAttribute("data-logo-choice") === id && logos[i].getAttribute("data-logo-kind") === form;
        logos[i].setAttribute("aria-checked", same ? "true" : "false");
      }
      paintIcon();
    }
    function paintIcon() {
      var id = root.getAttribute("data-logo") || "halftone";
      var hit = catalog[0];
      for (var i = 0; i < catalog.length; i++) if (catalog[i].id === id) hit = catalog[i];
      if (!hit) return;
      var dark = root.getAttribute("data-theme") !== "light";
      var icon = document.getElementById("site-favicon");
      var apple = document.getElementById("site-apple");
      if (icon) icon.href = dark ? hit.monoNight : hit.monoDay;
      if (apple) apple.href = dark ? hit.appleNight : hit.appleDay;
    }
    function paintTheme(theme, persist) {
      if (theme !== "light") theme = "dark";
      root.setAttribute("data-theme", theme);
      root.style.colorScheme = theme === "light" ? "light" : "dark";
      if (persist) {
        try { localStorage.setItem("artometrics-theme", theme); } catch (e) {}
      }
      var modes = document.querySelectorAll("[data-theme-choice]");
      for (var i = 0; i < modes.length; i++) {
        modes[i].setAttribute("aria-checked", modes[i].getAttribute("data-theme-choice") === theme ? "true" : "false");
      }
      paintLogo(root.getAttribute("data-logo") || "halftone", false);
    }
    function openPanel() {
      if (!panel || !toggle) return;
      panel.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
    }
    function closePanel() {
      if (!panel || !toggle) return;
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    }
    paintTheme(root.getAttribute("data-theme") || "dark", false);
    paintForm(root.getAttribute("data-logo-form") || "single", false);
    paintLogo(root.getAttribute("data-logo") || "halftone", false);

    toggle && toggle.addEventListener("click", function () {
      if (!panel) return;
      if (panel.hidden) openPanel();
      else closePanel();
    });
    var modes = document.querySelectorAll("[data-theme-choice]");
    for (var i = 0; i < modes.length; i++) {
      modes[i].addEventListener("click", function (event) {
        paintTheme(event.currentTarget.getAttribute("data-theme-choice"), true);
      });
    }
    var forms = document.querySelectorAll("[data-logo-form-choice]");
    for (var f = 0; f < forms.length; f++) {
      forms[f].addEventListener("click", function (event) {
        paintForm(event.currentTarget.getAttribute("data-logo-form-choice"), true);
        paintLogo(root.getAttribute("data-logo") || "halftone", false);
      });
    }
    var logos = document.querySelectorAll("[data-logo-choice]");
    for (var j = 0; j < logos.length; j++) {
      logos[j].addEventListener("click", function (event) {
        var button = event.currentTarget;
        paintForm(button.getAttribute("data-logo-kind") || "single", true);
        paintLogo(button.getAttribute("data-logo-choice"), true);
      });
    }
    var shelf = document.getElementById("nav-catalogue-row");
    if (shelf) {
      shelf.addEventListener("keydown", function (event) {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        var links = shelf.querySelectorAll(".nav-catalogue__card > a");
        var index = 0;
        for (var i = 0; i < links.length; i++) if (links[i] === document.activeElement || links[i].contains(document.activeElement)) index = i;
        var next = links[index + (event.key === "ArrowRight" ? 1 : -1)];
        if (!next) return;
        event.preventDefault();
        next.focus();
        next.scrollIntoView({ inline: "start", block: "nearest" });
      });
    }
    document.addEventListener("click", function (event) {
      if (!panel || panel.hidden) return;
      var target = event.target;
      if (panel.contains(target) || (toggle && toggle.contains(target))) return;
      closePanel();
    });
    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && panel && !panel.hidden) {
        closePanel();
        toggle && toggle.focus();
        return;
      }
      var target = event.target;
      if (!target || !target.getAttribute) return;
      var kind = target.hasAttribute("data-theme-choice") ? "theme" : target.hasAttribute("data-logo-choice") ? "logo" : "";
      if (!kind) return;
      if (event.key !== "ArrowRight" && event.key !== "ArrowLeft" && event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      var items = Array.prototype.slice.call(document.querySelectorAll(kind === "theme" ? "[data-theme-choice]" : "[data-logo-choice]"));
      var index = items.indexOf(target);
      if (index < 0) return;
      event.preventDefault();
      var delta = event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : -1;
      var next = items[(index + delta + items.length) % items.length];
      next.focus();
      next.click();
    });
  })();
</script>
