---
import { CONFIGURED_SOCIAL, UNCONFIGURED_SOCIAL } from "@/lib/social-links";

interface Props {
  variant?: "home" | "article" | "site";
  showSocial?: boolean;
}

const { variant = "site", showSocial = false } = Astro.props;
const year = new Date().getFullYear();
const primary = showSocial
  ? [
      ["/design-preview#reports", "Reports"],
      ["/sources", "Sources"],
      ["/rss.xml", "RSS"],
    ]
  : variant === "home"
    ? [
        ["#latest", "Latest"],
        ["#issues", "Issues"],
        ["#topics", "Topics"],
      ]
    : [
        ["/blog", "Reports"],
        ["/sources", "Sources"],
        ["/rss.xml", "RSS"],
      ];
const quiet = [
  ["/about", "About"],
  ["/legal/ethics-statement", "Legal"],
  ["/podcast", "Podcast"],
];
---

<footer class="site-footer">
  <div class="wrap">
    <a class="site-footer__mark" href={showSocial ? "/design-preview" : "/"}>Artometrics</a>
    <nav class="site-footer__links" aria-label="Footer">
      {primary.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <nav class="site-footer__social" aria-label="Social">
      <ul>
        {CONFIGURED_SOCIAL.map((item) => (
          <li><a href={item.href} rel="noreferrer">{item.label}</a></li>
        ))}
        {showSocial ? UNCONFIGURED_SOCIAL.map((label) => (
          <li>
            <span aria-disabled="true">{label} <span class="site-footer__unconfigured">not configured</span></span>
          </li>
        )) : null}
      </ul>
      {showSocial ? (
        <p class="site-footer__social-note">
          GitHub is the organization URL already published on the home page. X, Instagram, YouTube, and LinkedIn have no official URL in this repository.
        </p>
      ) : null}
    </nav>
    <p class="site-footer__base">
      © {year} Artometrics
      {quiet.map(([href, label]) => (
        <>
          <span aria-hidden="true"> · </span>
          <a href={href}>{label}</a>
        </>
      ))}
    </p>
  </div>
</footer>
