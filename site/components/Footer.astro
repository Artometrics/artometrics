---
const year = new Date().getFullYear();
const links = [
  ["/blog", "Reports"],
  ["/podcast", "Podcast"],
  ["/about", "About"],
  ["/sources", "Sources"],
  ["/rss.xml", "RSS"],
  ["/legal/ethics-statement", "Legal"],
];
---

<footer class="site-footer">
  <div class="wrap">
    <nav class="site-footer__links" aria-label="Footer">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <p class="site-footer__base">© {year} Artometrics</p>
  </div>
</footer>
