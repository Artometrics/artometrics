---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { magazineLines } from "@/lib/article-assets.mjs";
import type { BlogPost } from "@/lib/content";

interface Props {
  posts: BlogPost[];
  /** Homepage uses the visible story as the page heading. */
  pageHeading?: boolean;
  label?: string;
  hrefFor?: (post: BlogPost) => string;
}

const { posts, pageHeading = false, label = "Featured reports", hrefFor = (post) => `/${post.slug}` } = Astro.props;

function bannerSrc(post: BlogPost) {
  const file = join(process.cwd(), "public/images/content/articles", post.slug, "banner-art.webp");
  if (existsSync(file)) return `/images/content/articles/${post.slug}/banner-art.webp`;
  return post.heroImage || "";
}

const slides = posts
  .map((post) => ({ post, src: bannerSrc(post), lines: magazineLines(post.title) }))
  .filter((slide) => slide.src);
---

{slides.length ? (
  <section
    class="banner-carousel"
    data-banner-carousel
    aria-roledescription="carousel"
    aria-label={label}
    tabindex={slides.length > 1 ? 0 : undefined}
  >
    <div class="banner-carousel__viewport">
      {slides.map(({ post, src, lines }, index) => {
        const fit = !lines.word.includes(" ");
        const Tag = pageHeading && index === 0 ? "h1" : "p";
        return (
          <article
            class="desk-lead banner-carousel__slide"
            data-banner-slide
            hidden={index > 0}
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${slides.length}`}
          >
            <a class="desk-lead__hit" href={hrefFor(post)} draggable="false" data-contrast-skip>
              <img src={src} alt="" width="1600" height="900" draggable="false" />
              <div class="desk-lead__copy">
                <Tag class:list={["banner-carousel__word", { "banner-carousel__word--sentence": !fit }]} data-fit-box={fit ? "" : undefined}>
                  <span class="banner-carousel__kicker" data-fit={fit ? "" : undefined} data-fit-max="0.3">{lines.word}</span>
                  {lines.sub ? <span class="banner-carousel__sub">{lines.sub}</span> : null}
                </Tag>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </section>
) : null}

<script is:inline src="/js/fit-text.js"></script>
<script is:inline>
  (function () {
    var roots = document.querySelectorAll("[data-banner-carousel]:not([data-banner-ready])");
    for (var r = 0; r < roots.length; r++) init(roots[r]);

    function init(root) {
      root.setAttribute("data-banner-ready", "");
      var slides = root.querySelectorAll("[data-banner-slide]");
      if (slides.length < 2) return;
      var index = 0;

      function show(next) {
        index = (next + slides.length) % slides.length;
        for (var i = 0; i < slides.length; i++) slides[i].hidden = i !== index;
        if (window.__fitText) window.__fitText.fitAll(slides[index]);
      }
      /* Manual only: slides change on a swipe, a sideways wheel or an arrow key. No timer. */

      var x0 = 0;
      var y0 = 0;
      var swiped = false;
      root.addEventListener("touchstart", function (event) {
        var t = event.changedTouches[0];
        x0 = t.clientX;
        y0 = t.clientY;
        swiped = false;
      }, { passive: true });
      root.addEventListener("touchend", function (event) {
        var t = event.changedTouches[0];
        var dx = t.clientX - x0;
        var dy = t.clientY - y0;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.2) {
          swiped = true;
          show(index + (dx < 0 ? 1 : -1));
        }
      }, { passive: true });
      root.addEventListener("click", function (event) {
        if (swiped) {
          event.preventDefault();
          swiped = false;
        }
      }, true);
      var wheelAt = 0;
      root.addEventListener("wheel", function (event) {
        if (Math.abs(event.deltaX) < 30 || Math.abs(event.deltaX) < Math.abs(event.deltaY)) return;
        event.preventDefault();
        var now = Date.now();
        if (now - wheelAt < 600) return;
        wheelAt = now;
        show(index + (event.deltaX > 0 ? 1 : -1));
      }, { passive: false });
      root.addEventListener("keydown", function (event) {
        if (event.key === "ArrowRight") { show(index + 1); }
        if (event.key === "ArrowLeft") { show(index - 1); }
      });
    }
  })();
</script>
