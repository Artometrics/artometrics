---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { magazineLines } from "@/lib/article-assets.mjs";
import type { BlogPost } from "@/lib/content";

interface Props {
  posts: BlogPost[];
  /** Homepage uses the visible story as the page heading. */
  pageHeading?: boolean;
  label?: string;
  hrefFor?: (post: BlogPost) => string;
}

const { posts, pageHeading = false, label = "Featured reports", hrefFor = (post) => `/${post.slug}` } = Astro.props;

function bannerSrc(post: BlogPost) {
  const file = join(process.cwd(), "public/images/content/articles", post.slug, "banner-art.webp");
  if (existsSync(file)) return `/images/content/articles/${post.slug}/banner-art.webp`;
  return post.heroImage || "";
}

const slides = posts
  .map((post) => ({ post, src: bannerSrc(post), lines: magazineLines(post.title) }))
  .filter((slide) => slide.src);
---

{slides.length ? (
  <section class="banner-carousel" data-banner-carousel aria-roledescription="carousel" aria-label={label}>
    <div class="banner-carousel__viewport">
      {slides.map(({ post, src, lines }, index) => (
        <article class="desk-lead banner-carousel__slide" data-banner-slide hidden={index > 0}>
          <a class="desk-lead__hit" href={hrefFor(post)}>
            <img src={src} alt="" width="1600" height="900" />
            <div class="desk-lead__copy">
              {pageHeading && index === 0 ? (
                <h1 class:list={["banner-carousel__word", { "banner-carousel__word--sentence": lines.word.includes(" ") }]}>
                  <span class="banner-carousel__kicker">{lines.word}</span>
                  {lines.sub ? <span class="banner-carousel__sub">{lines.sub}</span> : null}
                </h1>
              ) : (
                <p class:list={["banner-carousel__word", { "banner-carousel__word--sentence": lines.word.includes(" ") }]}>
                  <span class="banner-carousel__kicker">{lines.word}</span>
                  {lines.sub ? <span class="banner-carousel__sub">{lines.sub}</span> : null}
                </p>
              )}
            </div>
          </a>
        </article>
      ))}
    </div>
    {slides.length > 1 ? (
      <div class="banner-carousel__controls">
        <button type="button" data-banner="prev">Previous</button>
        <button type="button" data-banner="next">Next</button>
        <p class="banner-carousel__status" aria-live="polite">1 of {slides.length}</p>
      </div>
    ) : null}
  </section>
) : null}

<script is:inline>
  (function () {
    var roots = document.querySelectorAll("[data-banner-carousel]:not([data-banner-ready])");
    for (var r = 0; r < roots.length; r++) init(roots[r]);

    /* Manual only: slides change on Previous, Next, a tap or a swipe. Nothing moves on a timer. */
    function init(root) {
      root.setAttribute("data-banner-ready", "");
      var slides = root.querySelectorAll("[data-banner-slide]");
      if (slides.length < 2) return;
      var index = 0;
      var status = root.querySelector(".banner-carousel__status");

      function show(next) {
        index = (next + slides.length) % slides.length;
        for (var i = 0; i < slides.length; i++) slides[i].hidden = i !== index;
        if (status) status.textContent = index + 1 + " of " + slides.length;
      }
      root.querySelector("[data-banner='prev']").addEventListener("click", function () { show(index - 1); });
      root.querySelector("[data-banner='next']").addEventListener("click", function () { show(index + 1); });

      var startX = 0;
      var startY = 0;
      var viewport = root.querySelector(".banner-carousel__viewport");
      viewport.addEventListener("touchstart", function (event) {
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
      }, { passive: true });
      viewport.addEventListener("touchend", function (event) {
        var dx = event.changedTouches[0].clientX - startX;
        var dy = event.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) show(dx < 0 ? index + 1 : index - 1);
      }, { passive: true });
    }
  })();
</script>
