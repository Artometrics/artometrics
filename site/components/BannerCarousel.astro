---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { deckLine, formatDate, sectionLabel, type BlogPost } from "@/lib/content";

interface Props {
  posts: BlogPost[];
  /** Homepage uses the visible story as the page heading. */
  pageHeading?: boolean;
  label?: string;
  hrefFor?: (post: BlogPost) => string;
}

const { posts, pageHeading = false, label = "Featured reports", hrefFor = (post) => `/${post.slug}` } = Astro.props;

function bannerSrc(post: BlogPost) {
  const file = join(process.cwd(), "public/images/content/articles", post.slug, "banner-art.webp");
  if (existsSync(file)) return `/images/content/articles/${post.slug}/banner-art.webp`;
  return post.heroImage || "";
}
function bannerText(post: BlogPost) {
  const file = join(process.cwd(), "public/images/content/articles", post.slug, "banner-text.webp");
  if (existsSync(file)) return `/images/content/articles/${post.slug}/banner-text.webp`;
  return "";
}

const slides = posts
  .map((post) => ({ post, src: bannerSrc(post), textHref: bannerText(post) }))
  .filter((slide) => slide.src);
---

{slides.length ? (
  <section class="banner-carousel" data-banner-carousel aria-roledescription="carousel" aria-label={label}>
    <div class="banner-carousel__viewport">
      {slides.map(({ post, src, textHref }, index) => (
        <article class="desk-lead banner-carousel__slide" data-banner-slide hidden={index > 0}>
          <a class="desk-lead__hit" href={hrefFor(post)}>
            <img src={src} alt="" width="1600" height="900" />
            <div class="desk-lead__copy">
              <p class="desk-lead__kicker">{sectionLabel(post.tags, post.subject) || "Report"}</p>
              {pageHeading && index === 0 ? <h1>{post.title}</h1> : <p class="banner-carousel__heading">{post.title}</p>}
              <p class="desk-lead__dek">{deckLine(post.description, 18)}</p>
              {post.pubDate ? <p class="desk-lead__meta">{formatDate(post.pubDate)}</p> : null}
            </div>
          </a>
          {textHref ? <a class="banner-carousel__download" href={textHref} download>Banner with title</a> : null}
        </article>
      ))}
    </div>
    {slides.length > 1 ? (
      <div class="banner-carousel__controls">
        <button type="button" data-banner="prev">Previous</button>
        <button type="button" data-banner="pause" aria-pressed="false">Pause</button>
        <button type="button" data-banner="next">Next</button>
        <p class="banner-carousel__status" aria-live="polite">1 of {slides.length}</p>
      </div>
    ) : null}
  </section>
) : null}

<script is:inline>
  (function () {
    var roots = document.querySelectorAll("[data-banner-carousel]:not([data-banner-ready])");
    for (var r = 0; r < roots.length; r++) init(roots[r]);

    function init(root) {
      root.setAttribute("data-banner-ready", "");
      var slides = root.querySelectorAll("[data-banner-slide]");
      if (slides.length < 2) return;
      var index = 0;
      var status = root.querySelector(".banner-carousel__status");
      var pauseBtn = root.querySelector("[data-banner='pause']");
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var userPaused = reduce;
      var hovering = false;
      var focused = false;
      var timer = 0;

      function show(next) {
        index = (next + slides.length) % slides.length;
        for (var i = 0; i < slides.length; i++) slides[i].hidden = i !== index;
        if (status) status.textContent = index + 1 + " of " + slides.length;
      }
      function running() {
        return !userPaused && !hovering && !focused && !reduce;
      }
      function paintPause() {
        if (!pauseBtn) return;
        var paused = !running();
        pauseBtn.setAttribute("aria-pressed", paused ? "true" : "false");
        pauseBtn.textContent = paused ? "Play" : "Pause";
      }
      function tick() {
        if (running()) show(index + 1);
      }
      root.querySelector("[data-banner='prev']").addEventListener("click", function () { show(index - 1); });
      root.querySelector("[data-banner='next']").addEventListener("click", function () { show(index + 1); });
      pauseBtn.addEventListener("click", function () {
        userPaused = !userPaused;
        paintPause();
      });
      root.addEventListener("mouseenter", function () { hovering = true; paintPause(); });
      root.addEventListener("mouseleave", function () { hovering = false; paintPause(); });
      root.addEventListener("focusin", function () { focused = true; paintPause(); });
      root.addEventListener("focusout", function (event) {
        if (root.contains(event.relatedTarget)) return;
        focused = false;
        paintPause();
      });
      paintPause();
      timer = window.setInterval(tick, 7000);
    }
  })();
</script>
