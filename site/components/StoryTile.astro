---
import { magazineLines } from "@/lib/article-assets.mjs";
import type { BlogPost } from "@/lib/content";

interface Props {
  post: BlogPost;
  art: { src: string; htmlTitle: boolean; textStatus?: string };
}

const { post, art } = Astro.props;
const lines = magazineLines(post.title);
const showTitle = art.htmlTitle || art.textStatus === "unknown";
---

<a class="story-tile" href={`/${post.slug}`} data-text-free={showTitle ? "true" : "false"}>
  <img src={art.src} alt={showTitle ? "" : post.title} width="800" height="800" loading="lazy" decoding="async" />
  {showTitle ? (
    <span class="story-tile__title">
      <span class="story-tile__word">{lines.word}</span>
      {lines.sub ? <span class="story-tile__sub">{lines.sub}</span> : null}
    </span>
  ) : null}
</a>
