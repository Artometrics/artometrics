---
import { magazineLines } from "@/lib/article-assets.mjs";
import type { BlogPost } from "@/lib/content";

interface Props {
  post: BlogPost;
  art: { src: string; htmlTitle: boolean };
}

const { post, art } = Astro.props;
const lines = magazineLines(post.title);
const fit = !lines.word.includes(" ");
---

<a class="story-tile" href={`/${post.slug}`}>
  <img src={art.src} alt="" width="800" height="800" loading="lazy" decoding="async" />
  <span class="story-tile__title" data-fit-box={fit ? "" : undefined}>
    <span class:list={["story-tile__word", { "story-tile__word--wrap": !fit }]} data-fit={fit ? "" : undefined} data-fit-max="0.4">{lines.word}</span>
  </span>
</a>
<script is:inline src="/js/fit-text.js"></script>
