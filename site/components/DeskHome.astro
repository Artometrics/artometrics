---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { deckLine, formatDate, getBlogPost, sectionLabel } from "@/lib/content";

/** Four category columns are visible; swipe for Humanities and Civics.
 * Each column is three real reports. Longevity is not on this page.
 * Steam is sports and already the fourth sports report with new art, so the sports column keeps Dodgers, Padres, and Celtics.
 * New square-text files are missing for Readmitted, Caesar, Beyoncé, Emperors, Atlas, and Exporters. Those tiles use the existing article hero.
 */
const desks = [
  { label: "Arts", href: "/topics/arts", slugs: ["pixar", "anime", "franchise"] },
  { label: "Sports", href: "/topics/sports", slugs: ["dodgers", "padres", "celtics"] },
  { label: "Science", href: "/topics/science", slugs: ["nuclear", "cetaceans", "readmitted"] },
  { label: "Culture", href: "/topics/culture", slugs: ["wine", "coffee", "ramen"] },
  { label: "Humanities", href: "/topics/humanities", slugs: ["caesar", "beyonce", "emperors"] },
  { label: "Civics", href: "/topics/civics", slugs: ["geopolitics", "atlas", "exporters"] },
];

function tileSrc(slug: string, heroImage?: string) {
  const square = join(process.cwd(), "public/images/content/articles", slug, "square-text.webp");
  if (existsSync(square)) return { src: `/images/content/articles/${slug}/square-text.webp`, kind: "square-text" };
  return { src: heroImage || "", kind: "hero" };
}

const lead = getBlogPost("geopolitics");
const columns = desks.map((desk) => ({
  ...desk,
  stories: desk.slugs.flatMap((slug) => {
    const post = getBlogPost(slug);
    if (!post) return [];
    const art = tileSrc(slug, post.heroImage);
    return art.src ? [{ post, art }] : [];
  }),
}));
---

<div class="desk-home">
  {lead ? (
    <article class="desk-lead">
      <a class="desk-lead__hit" href={`/${lead.slug}`}>
        <img src={`/images/content/articles/${lead.slug}/banner-art.webp`} alt="" width="1600" height="900" />
        <div class="desk-lead__copy">
          <p class="desk-lead__kicker">{sectionLabel(lead.tags, lead.subject) || "Report"}</p>
          <h1>{lead.title}</h1>
          <p class="desk-lead__dek">{deckLine(lead.description, 18)}</p>
          {lead.pubDate ? <p class="desk-lead__meta">{formatDate(lead.pubDate)}</p> : null}
        </div>
      </a>
    </article>
  ) : null}

  <div class="desk-periods" role="radiogroup" aria-label="Period">
    <button type="button" data-front-view="week" aria-checked="true">Week</button>
    <button type="button" data-front-view="month" aria-checked="false">Month</button>
    <button type="button" data-front-view="all" aria-checked="false">All time</button>
  </div>
  <div class="desk-rail" id="desk-rail" tabindex="0" aria-label="Category columns">
    {columns.map((desk) => (
      <section class="desk-column" aria-labelledby={`desk-${desk.label}`}>
        <h2 id={`desk-${desk.label}`}><a href={desk.href}>{desk.label}</a></h2>
        {desk.stories.map(({ post, art }) => (
          <a class="story-tile" href={`/${post.slug}`}>
            <img src={art.src} alt={post.title} width="800" height="800" data-art={art.kind} />
          </a>
        ))}
      </section>
    ))}
  </div>
</div>
<script is:inline>
  (function () {
    var rail = document.getElementById("desk-rail");
    if (rail) {
      rail.addEventListener("keydown", function (event) {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        var columns = rail.querySelectorAll(".desk-column");
        var active = document.activeElement;
        var index = 0;
        for (var i = 0; i < columns.length; i++) if (columns[i].contains(active)) index = i;
        var next = columns[index + (event.key === "ArrowRight" ? 1 : -1)];
        if (!next) return;
        event.preventDefault();
        var link = next.querySelector("h2 a");
        if (link) link.focus();
        next.scrollIntoView({ inline: "start", block: "nearest" });
      });
    }
    var buttons = document.querySelectorAll("[data-front-view]");
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].addEventListener("click", function (event) {
        var chosen = event.currentTarget;
        for (var j = 0; j < buttons.length; j++) {
          buttons[j].setAttribute("aria-checked", buttons[j] === chosen ? "true" : "false");
        }
      });
    }
  })();
</script>
