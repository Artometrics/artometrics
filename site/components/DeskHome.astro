---
import { deckLine, formatDate, getBlogPost, reportKicker, sectionLabel } from "@/lib/content";

/** Curated front page. Steam is shown with Arts on this page. */
const desks = [
  { label: "Arts", href: "/topics/arts", slugs: ["pixar", "anime", "franchise", "steam"] },
  { label: "Sports", href: "/topics/sports", slugs: ["dodgers", "padres"] },
  { label: "Culture", href: "/topics/culture", slugs: ["wine", "coffee", "ramen"] },
  { label: "Science", href: "/topics/science", slugs: ["nuclear", "cetaceans", "longevity"] },
];

const lead = getBlogPost("geopolitics");
const stories = desks.flatMap((desk) =>
  desk.slugs.flatMap((slug) => {
    const post = getBlogPost(slug);
    return post ? [post] : [];
  }),
);
---

<div class="desk-home">
  <div class="desk-periods" role="radiogroup" aria-label="Period">
    <button type="button" data-front-period="week" aria-checked="true">
      <svg class="desk-fire" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 2s1.8 2.6 1.8 4.6A2.7 2.7 0 0 1 12 9.2c1.7.1 3.4 1.6 3.4 4.1A5.4 5.4 0 1 1 6.4 12c.2-1.6 1.2-3.2 2.6-4.1.1 1.6 1.1 2.6 2.1 2.6C10.2 7.6 12 4.4 12 2z"></path></svg>
      This week
    </button>
    <button type="button" data-front-period="month" aria-checked="false">
      <svg class="desk-fire" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 2s1.8 2.6 1.8 4.6A2.7 2.7 0 0 1 12 9.2c1.7.1 3.4 1.6 3.4 4.1A5.4 5.4 0 1 1 6.4 12c.2-1.6 1.2-3.2 2.6-4.1.1 1.6 1.1 2.6 2.1 2.6C10.2 7.6 12 4.4 12 2z"></path></svg>
      This month
    </button>
    <button type="button" data-front-period="all" aria-checked="false">
      <svg class="desk-fire" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 2s1.8 2.6 1.8 4.6A2.7 2.7 0 0 1 12 9.2c1.7.1 3.4 1.6 3.4 4.1A5.4 5.4 0 1 1 6.4 12c.2-1.6 1.2-3.2 2.6-4.1.1 1.6 1.1 2.6 2.1 2.6C10.2 7.6 12 4.4 12 2z"></path></svg>
      All time
    </button>
  </div>
  <p class="desk-period-note">Front-page selection. Not an engagement ranking.</p>

  {lead ? (
    <article class="desk-lead">
      <a class="desk-lead__hit" href={`/${lead.slug}`}>
        {lead.heroImage ? <img src={lead.heroImage} alt="" width="1200" height="360" /> : null}
        <div class="desk-lead__copy">
          <p class="desk-lead__kicker">{sectionLabel(lead.tags, lead.subject) || "Report"}</p>
          <h1>{lead.title}</h1>
          <p class="desk-lead__dek">{deckLine(lead.description, 18)}</p>
          {lead.pubDate ? <p class="desk-lead__meta">{formatDate(lead.pubDate)}</p> : null}
        </div>
      </a>
    </article>
  ) : null}

  <p class="desk-home__jumps"><a href="/blog">All reports</a></p>
  <div class="story-grid">
    {stories.map((post) => (
      <a class="story-tile" href={`/${post.slug}`}>
        {post.heroImage ? <img src={post.heroImage} alt="" width="240" height="240" /> : <span class="story-tile__fallback" aria-hidden="true"></span>}
        <span>{reportKicker(post.title, post.subject)}</span>
      </a>
    ))}
  </div>
</div>
<script is:inline>
  (function () {
    var buttons = document.querySelectorAll("[data-front-period]");
    for (var i = 0; i < buttons.length; i++) {
      buttons[i].addEventListener("click", function (event) {
        var chosen = event.currentTarget;
        for (var j = 0; j < buttons.length; j++) {
          buttons[j].setAttribute("aria-checked", buttons[j] === chosen ? "true" : "false");
        }
      });
    }
  })();
</script>
