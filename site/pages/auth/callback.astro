---
import Base from "../../layouts/Base.astro";
---

<Base title="Signing in" description="Return URL for Artometrics sign-in." path="/auth/callback">
  <div class="wrap wrap--narrow page">
    <h1>Signing in</h1>
    <p class="lede">This address is the return URL for member sign-in. The static host does not exchange tokens. Continue to the account page after you are signed in on the member app.</p>
    <p><a href="/account">Account</a> · <a href="/login">Log in</a></p>
  </div>
</Base>
