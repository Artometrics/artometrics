---
import Base from "../layouts/Base.astro";
---

<Base title="Welcome" description="Start with a report, the magazine, or a desk." path="/welcome">
  <div class="wrap wrap--narrow page">
    <p class="kicker">Welcome</p>
    <h1>Start anywhere</h1>
    <p class="lede">Artometrics is a data magazine. The front page leads with this week's investigation.</p>
    <p class="actions">
      <a class="btn" href="/">Front page</a>
      <a class="btn btn--ghost" href="/blog">All reports</a>
    </p>
  </div>
</Base>
