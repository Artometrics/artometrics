---
import Base from "../../layouts/Base.astro";
import {
  DOMAIN_META,
  DOMAIN_SLUGS,
  LEGACY_DESK_TO_SECTION,
  LEGACY_SECTION_TO_DOMAIN,
  SUBDOMAIN_META,
  type DomainSlug,
} from "@/data/sections";
import { getBlogPosts, primarySection, primarySubdomain, sectionLabel, deckLine, formatDate } from "@/lib/content";

export function getStaticPaths() {
  const legacy = [
    ...Object.keys(LEGACY_SECTION_TO_DOMAIN),
    ...Object.keys(LEGACY_DESK_TO_SECTION),
  ];
  return [...DOMAIN_SLUGS, ...legacy].map((channel) => ({ params: { channel } }));
}

const raw = Astro.params.channel || "";
const mapped = (DOMAIN_SLUGS.includes(raw as DomainSlug)
  ? raw
  : LEGACY_SECTION_TO_DOMAIN[raw] || LEGACY_DESK_TO_SECTION[raw]) as DomainSlug | undefined;
const meta = mapped ? DOMAIN_META[mapped] : null;
const posts = meta ? getBlogPosts().filter((post) => primarySection(post.tags) === mapped) : [];
const subs = new Map<string, number>();
for (const post of posts) {
  const sub = primarySubdomain(post.tags);
  if (sub) subs.set(sub, (subs.get(sub) || 0) + 1);
}
---

<Base
  title={meta?.title || "Topic"}
  description={meta?.description || "Section"}
  path={mapped ? `/topics/${mapped}` : `/topics/${raw}`}
>
  <div class="wrap page">
    {meta && mapped ? (
      <>
        <p class="kicker">Desk</p>
        <h1>{meta.title}</h1>
        <p class="lede">{meta.description}</p>
        <nav class="filters" aria-label="Subdomains">
          {[...subs.keys()].map((sub) => (
            <a href={`/blog?subdomain=${sub}`}>{SUBDOMAIN_META[sub as keyof typeof SUBDOMAIN_META]?.title || sub}</a>
          ))}
        </nav>
        <div class="stack">
          {posts.map((post) => (
            <a class="card" href={`/${post.slug}`}>
              <span class="kicker">{sectionLabel(post.tags, post.subject)} · {formatDate(post.pubDate)}</span>
              <h2>{post.title}</h2>
              <span class="lede">{deckLine(post.description, 24)}</span>
            </a>
          ))}
        </div>
      </>
    ) : (
      <>
        <h1>Section not found</h1>
        <p><a href="/topics">All topics</a></p>
      </>
    )}
  </div>
</Base>
