---
import Base from "../../layouts/Base.astro";
import BannerCarousel from "../../components/BannerCarousel.astro";
import DeskBoard from "../../components/DeskBoard.astro";
import {
  DOMAIN_META,
  DOMAIN_SLUGS,
  LEGACY_DESK_TO_SECTION,
  LEGACY_SECTION_TO_DOMAIN,
  SUBDOMAIN_META,
  type DomainSlug,
  type SubdomainSlug,
} from "@/data/sections";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { getBlogPosts, primarySection, primarySubdomain } from "@/lib/content";

export function getStaticPaths() {
  const legacy = [
    ...Object.keys(LEGACY_SECTION_TO_DOMAIN),
    ...Object.keys(LEGACY_DESK_TO_SECTION),
  ];
  return [...DOMAIN_SLUGS, ...legacy].map((channel) => ({ params: { channel } }));
}

const raw = Astro.params.channel || "";
const mapped = (DOMAIN_SLUGS.includes(raw as DomainSlug)
  ? raw
  : LEGACY_SECTION_TO_DOMAIN[raw] || LEGACY_DESK_TO_SECTION[raw]) as DomainSlug | undefined;
const meta = mapped ? DOMAIN_META[mapped] : null;
const posts = meta ? getBlogPosts().filter((post) => primarySection(post.tags) === mapped) : [];
const groups = meta
  ? meta.subdomains.map((sub) => ({
      label: SUBDOMAIN_META[sub as SubdomainSlug]?.title || sub,
      href: `/topics/${mapped}/${sub}`,
      posts: posts.filter((post) => primarySubdomain(post.tags) === sub),
    }))
  : [];
const filed = groups.reduce((sum, group) => sum + group.posts.length, 0);
const loose = posts.filter((post) => !groups.some((group) => group.posts.includes(post)));
if (loose.length) groups.push({ label: "Reports", href: "", posts: loose });
const slides = [
  ...posts.filter((post) => existsSync(join(process.cwd(), "public/images/content/articles", post.slug, "banner-art.webp"))),
  ...posts.filter((post) => !existsSync(join(process.cwd(), "public/images/content/articles", post.slug, "banner-art.webp"))),
].slice(0, Math.min(3, posts.length));
---

<Base
  title={meta?.title || "Topic"}
  description={meta?.description || "Section"}
  path={mapped ? `/topics/${mapped}` : `/topics/${raw}`}
>
  <div class="desk-home">
    {meta && mapped ? (
      <>
        <p class="desk-lead__kicker"><a href="/">Reports</a> · {meta.title}</p>
        <h1 class="desk-page-title">{meta.title}</h1>
        <p class="desk-page-dek">{meta.description}</p>
        <BannerCarousel posts={slides} label={`${meta.title} reports`} />
        <DeskBoard groups={groups} empty={`No reports filed in ${meta.title} yet.`} />
        {filed === 0 && loose.length === 0 ? null : (
          <details class="desk-filter">
            <summary>Filter titles</summary>
            <input id="desk-filter" type="search" aria-label={`Filter ${meta.title} reports`} />
          </details>
        )}
      </>
    ) : (
      <>
        <h1 class="desk-page-title">Section not found</h1>
        <p><a href="/topics">All topics</a></p>
      </>
    )}
  </div>
  <script is:inline>
    (function () {
      var input = document.getElementById("desk-filter");
      if (!input) return;
      input.addEventListener("input", function () {
        var q = input.value.trim().toLowerCase();
        var tiles = document.querySelectorAll(".story-tile");
        for (var i = 0; i < tiles.length; i++) {
          var text = (tiles[i].innerText || tiles[i].getAttribute("href") || "").toLowerCase();
          tiles[i].hidden = q.length > 0 && !text.includes(q);
        }
      });
    })();
  </script>
</Base>
