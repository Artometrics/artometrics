---
import Base from "../../../layouts/Base.astro";
import BannerCarousel from "../../../components/BannerCarousel.astro";
import {
  DOMAIN_META,
  DOMAIN_SLUGS,
  SUBDOMAIN_META,
  type DomainSlug,
  type SubdomainSlug,
} from "@/data/sections";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { getBlogPosts, primarySection, primarySubdomain } from "@/lib/content";

export function getStaticPaths() {
  const posts = getBlogPosts();
  const paths = [];
  for (const channel of DOMAIN_SLUGS) {
    for (const sub of DOMAIN_META[channel].subdomains) {
      const has = posts.some(
        (post) => primarySection(post.tags) === channel && primarySubdomain(post.tags) === sub,
      );
      if (has) paths.push({ params: { channel, sub } });
    }
  }
  return paths;
}

const channel = Astro.params.channel as DomainSlug;
const sub = Astro.params.sub as SubdomainSlug;
const meta = DOMAIN_META[channel];
const subMeta = SUBDOMAIN_META[sub];
const posts = getBlogPosts().filter(
  (post) => primarySection(post.tags) === channel && primarySubdomain(post.tags) === sub,
);

function tileSrc(slug: string, hero?: string) {
  const square = join(process.cwd(), "public/images/content/articles", slug, "square-text.webp");
  if (existsSync(square)) return `/images/content/articles/${slug}/square-text.webp`;
  return hero || "";
}
---

<Base title={subMeta?.title || sub} description={meta.description} path={`/topics/${channel}/${sub}`}>
  <div class="desk-home">
    <p class="desk-lead__kicker"><a href={`/topics/${channel}`}>{meta.title}</a></p>
    <h1 class="desk-page-title">{subMeta?.title || sub}</h1>
    {posts.length ? <BannerCarousel posts={posts.slice(0, Math.min(3, posts.length))} label={`${subMeta?.title || sub} reports`} /> : null}
    {posts.length ? (
      <div class="story-grid">
        {posts.map((post) => (
          <a class="story-tile" href={`/${post.slug}`}>
            <img src={tileSrc(post.slug, post.heroImage)} alt={post.title} width="800" height="800" />
          </a>
        ))}
      </div>
    ) : (
      <p>No reports filed in {subMeta?.title || sub} yet.</p>
    )}
  </div>
</Base>
