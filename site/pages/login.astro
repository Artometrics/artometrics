---
import Base from "../layouts/Base.astro";
---

<Base title="Log in" description="Sign in to Artometrics Studio and membership." path="/login">
  <div class="wrap wrap--narrow page">
    <p class="kicker">Account</p>
    <h1>Log in</h1>
    <p class="lede">
      Email and Google sign-in talk to Supabase. Those secrets are not in this static host, so this page does not collect a password.
      Membership still lives at the same URL when the member API is attached.
    </p>
    <p><a href="/signup">Create an account</a> · <a href="/pricing">Pricing</a> · <a href="mailto:hello@artometrics.com">Email the desk</a></p>
  </div>
</Base>
