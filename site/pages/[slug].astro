---
import Base from "../layouts/Base.astro";
import {
  formatAuthorName,
  formatDate,
  getBlogPosts,
  getRelatedPosts,
  parseKeyPoint,
  reportHeadlineRest,
  reportKicker,
  sectionLabel,
} from "@/lib/content";
import { DOMAIN_META, SUBDOMAIN_META, primaryDomain, primarySubdomain } from "@/data/sections";
import { magazineIssue, magazineIssueHref } from "@/lib/magazine";
import downloads from "@/src/generated/downloads.json";
import { existsSync } from "node:fs";
import { readingMinutes, withStaticCharts } from "../lib/static-charts";

export function getStaticPaths() {
  return getBlogPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const label = sectionLabel(post.tags, post.subject);
const kicker = reportKicker(post.title, post.subject);
const headlineRest = reportHeadlineRest(post.title);
const minutes = readingMinutes(post.body || "");
const author = post.author ? formatAuthorName(String(post.author)) : "Kyle McAuliffe";
const domain = primaryDomain(post.tags || []);
const sub = primarySubdomain(post.tags || []);
const issue = magazineIssue(post.slug);
const audioFile = post.audioSrc && !String(post.audioSrc).startsWith("http")
  ? existsSync(new URL(`../../public${post.audioSrc}`, import.meta.url))
  : Boolean(post.audioSrc);
const pack = downloads[post.slug as keyof typeof downloads] as
  | {
      dataset?: string | null;
      pdf?: string | null;
      epub?: string | null;
      audio?: string | null;
      transcript?: string | null;
      html?: string | null;
    }
  | undefined;
const files = [
  pack?.dataset ? ["Dataset", pack.dataset] : null,
  pack?.pdf ? ["PDF", pack.pdf] : null,
  pack?.epub ? ["EPUB", pack.epub] : null,
  pack?.audio ? ["Audio", pack.audio] : null,
  pack?.transcript ? ["Transcript", pack.transcript] : null,
  pack?.html ? ["HTML", pack.html] : null,
  audioFile && post.audioSrc ? ["Narration", post.audioSrc] : null,
].filter(Boolean) as [string, string][];
const related = getRelatedPosts(post.slug, 3);
const faq = (post.faq || []) as { question: string; answer: string }[];
const image = post.heroImage || "/images/brand/og-default.png";
const body = post.body || "";
const embeddedFacts = body.includes('class="facts-grid"');
const points = embeddedFacts ? [] : ((post.keyPoints || []) as string[]);
const facts = points.map((point) => parseKeyPoint(String(point))).filter((fact) => fact.value);
const factSource = /data-source="([^"]+)"/.exec(body)?.[1]
  ?.replace(/\s+[—-]\s+ARTOMETRICS\s*$/i, "")
  .trim() || "";
const tones = ["", "fast-fact--pink", "fast-fact--blue"];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: post.title,
    description: post.description,
    datePublished: post.pubDate,
    image: [image.startsWith("http") ? image : `https://artometrics.com${image}`],
    author: { "@type": "Person", name: author },
    publisher: { "@type": "Organization", name: "Artometrics", url: "https://artometrics.com" },
    mainEntityOfPage: `https://artometrics.com/${post.slug}`,
    articleSection: label || DOMAIN_META[domain].title,
  },
  ...(faq.length
    ? [{
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      }]
    : []),
];
---

<Base
  title={post.title}
  description={post.description}
  path={`/${post.slug}`}
  image={image}
  type="article"
  jsonLd={jsonLd}
  footer="article"
>
  <link slot="head" rel="stylesheet" href="/css/artometrics-article.css" />
  <link slot="head" rel="stylesheet" href="/css/astro-contrast.css" />
  <article class="report">
    <p class="report-crumb">
      <a href="/blog">Reports</a>
      {" · "}
      <a href={`/topics/${domain}`}>{DOMAIN_META[domain].title}</a>
      {sub && SUBDOMAIN_META[sub] ? (
        <>
          {" · "}
          <a href={`/blog?subdomain=${sub}`}>{SUBDOMAIN_META[sub].title}</a>
        </>
      ) : null}
    </p>

    <header class="report-head">
      {label ? <p class="pill">{label}</p> : null}
      <h1>
        <span class="report-kicker">{kicker}:</span>
        {" "}{headlineRest}
      </h1>
      <p class="report-dek">{post.description}</p>
      <p class="report-byline">
        By {author}{post.pubDate ? ` · ${formatDate(post.pubDate)}` : ""} · {minutes} min
      </p>
      {issue ? (
        <p class="report-ebook"><a href={magazineIssueHref(issue.slug)}>Read as ebook</a></p>
      ) : null}
      {audioFile && post.audioSrc ? (
        <audio controls preload="none" src={post.audioSrc}>
          <a href={post.audioSrc}>Listen</a>
        </audio>
      ) : null}
    </header>

    {post.heroImage ? (
      <figure class="report-hero">
        <img src={post.heroImage} alt={post.title} />
      </figure>
    ) : null}

    {facts.length ? (
      <section class="fast-facts" aria-label="Fast facts">
        <h2>Fast facts</h2>
        <div class="fast-facts__grid">
          {facts.map((fact, index) => {
            const wide = facts.length % 2 === 1 && index === facts.length - 1;
            const long = fact.value.length > 18;
            return (
              <div class:list={["fast-fact", tones[index % 3], wide && "fast-fact--wide", long && "fast-fact--long"]}>
                <p class="fast-fact__num">{fact.value}</p>
                {fact.label ? <p class="fast-fact__lbl">{fact.label}</p> : null}
              </div>
            );
          })}
        </div>
        {factSource ? <p class="fast-facts__src">Source: {factSource}</p> : null}
      </section>
    ) : null}

    {files.length ? (
      <p class="report-files">
        {files.map(([name, href]) => <a href={href}>{name}</a>)}
      </p>
    ) : null}

    <div class="artometrics-article-body" set:html={withStaticCharts(body)} />

    {related.length ? (
      <section class="report-related">
        <h2>Related</h2>
        {related.map((item) => (
          <a href={`/${item.slug}`}>
            <span class="report-kicker">{reportKicker(item.title, item.subject)}:</span>
            {" "}{reportHeadlineRest(item.title)}
          </a>
        ))}
      </section>
    ) : null}
  </article>
</Base>
