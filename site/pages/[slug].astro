---
import Base from "../layouts/Base.astro";
import {
  formatAuthorName,
  formatDate,
  getBlogPosts,
  getRelatedPosts,
  parseKeyPoint,
  reportHeadlineRest,
  reportKicker,
  sectionLabel,
} from "@/lib/content";
import { DOMAIN_META, SUBDOMAIN_META, primaryDomain, primarySubdomain } from "@/data/sections";
import downloads from "@/src/generated/downloads.json";
import { existsSync } from "node:fs";
import { readingMinutes, withStaticCharts } from "../lib/static-charts";
import ArtBarChart from "../components/preview/ArtBarChart.astro";
import { artworkDownloads } from "@/lib/article-assets.mjs";
import { previewFiles } from "../lib/preview-reports";

export function getStaticPaths() {
  return getBlogPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const label = sectionLabel(post.tags, post.subject);
const kicker = reportKicker(post.title, post.subject);
const headlineRest = reportHeadlineRest(post.title);
const minutes = readingMinutes(post.body || "");
const author = post.author ? formatAuthorName(String(post.author)) : "Kyle McAuliffe";
const domain = primaryDomain(post.tags || []);
const sub = primarySubdomain(post.tags || []);
const audioFile = post.audioSrc && !String(post.audioSrc).startsWith("http")
  ? existsSync(new URL(`../../public${post.audioSrc}`, import.meta.url))
  : Boolean(post.audioSrc);
const pack = downloads[post.slug as keyof typeof downloads] as
  | {
      dataset?: string | null;
      pdf?: string | null;
      epub?: string | null;
      audio?: string | null;
      transcript?: string | null;
      html?: string | null;
    }
  | undefined;
const files = [
  ...previewFiles(post.slug),
  audioFile && post.audioSrc && !pack?.audio ? { label: "Narration", href: post.audioSrc } : null,
].filter((file): file is { label: string; href: string } => Boolean(file));
const artwork = artworkDownloads(post.slug);
const related = getRelatedPosts(post.slug, 3);
const faq = (post.faq || []) as { question: string; answer: string }[];
const image = post.heroImage || "/images/brand/og-default.png";
const body = post.body || "";
const embeddedFacts = body.includes('class="facts-grid"');
const points = embeddedFacts ? [] : ((post.keyPoints || []) as string[]);
const facts = points.map((point) => parseKeyPoint(String(point))).filter((fact) => fact.value);
const factSource = /data-source="([^"]+)"/.exec(body)?.[1]
  ?.replace(/\s+[—-]\s+ARTOMETRICS\s*$/i, "")
  .trim() || "";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: post.title,
    description: post.description,
    datePublished: post.pubDate,
    image: [image.startsWith("http") ? image : `https://artometrics.com${image}`],
    author: { "@type": "Person", name: author },
    publisher: { "@type": "Organization", name: "Artometrics", url: "https://artometrics.com" },
    mainEntityOfPage: `https://artometrics.com/${post.slug}`,
    articleSection: label || DOMAIN_META[domain].title,
  },
  ...(faq.length
    ? [{
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      }]
    : []),
];
---

<Base
  title={post.title}
  description={post.description}
  path={`/${post.slug}`}
  image={image}
  type="article"
  jsonLd={jsonLd}
  footer="article"
  bodyClass="dash"
>
  <link slot="head" rel="stylesheet" href="/css/artometrics-article.css" />
  <link slot="head" rel="stylesheet" href="/css/astro-contrast.css" />
  <article class="preview-frame preview-report">
    {post.slug === "franchise" ? (
      <figure class="franchise-banner">
        <img
          src="/images/content/articles/franchise/banner.png"
          alt="Franchise"
          width="2560"
          height="1440"
        />
      </figure>
    ) : null}
    <p class="preview-crumb">
      <a href="/#reports">Reports</a>
      <span aria-hidden="true"> · </span>
      <a href={`/topics/${domain}`}>{DOMAIN_META[domain].title}</a>
      {sub && SUBDOMAIN_META[sub] ? (
        <>
          <span aria-hidden="true"> · </span>
          <a href={`/topics/${domain}?sub=${sub}`}>{SUBDOMAIN_META[sub].title}</a>
        </>
      ) : null}
    </p>

    <div class="preview-report-top">
      <div>
        <h1>
          <span class="report-kicker">{kicker}:</span>
          {" "}{headlineRest}
        </h1>
        <p class="preview-dek">{post.description}</p>
        <ul class="preview-meta">
          {label ? <li>{label}</li> : null}
          <li>By {author}</li>
          {post.pubDate ? <li>{formatDate(post.pubDate)}</li> : null}
          <li>{minutes} min</li>
        </ul>
        {files.length ? (
          <ul class="preview-files">
            {files.map((file) => (
              <li><a href={file.href}>{file.label}</a></li>
            ))}
          </ul>
        ) : null}
        {artwork.length ? (
          <ul class="preview-files" aria-label="Artwork downloads">
            {artwork.map((file) => (
              <li><a href={file.href} download>{file.label}</a></li>
            ))}
          </ul>
        ) : null}
        {audioFile && post.audioSrc ? (
          <audio controls preload="none" src={post.audioSrc}>
            <a href={post.audioSrc}>Listen</a>
          </audio>
        ) : null}
      </div>
      {facts.length ? (
        <div class="preview-facts-wrap">
        <table class="preview-facts">
          <caption>Published figures from this report.{factSource ? ` Source: ${factSource}` : ""}</caption>
          <thead>
            <tr>
              <th scope="col">Figure</th>
              <th scope="col">As published</th>
            </tr>
          </thead>
          <tbody>
            {facts.map((fact) => (
              <tr>
                <th scope="row">{fact.value}</th>
                <td>{fact.label}</td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
      ) : null}
    </div>

    {post.slug === "longevity" ? (
      <section class="preview-panel" aria-labelledby="leaders-title">
        <h2 id="leaders-title">Top 12 countries by average life expectancy across all years</h2>
        <ArtBarChart labelledBy="leaders-title" />
      </section>
    ) : null}

    <div class="artometrics-article-body" set:html={withStaticCharts(body)} />

    {related.length ? (
      <section class="report-related">
        <h2>Related</h2>
        {related.map((item) => (
          <a href={`/${item.slug}`}>
            <span class="report-kicker">{reportKicker(item.title, item.subject)}:</span>
            {" "}{reportHeadlineRest(item.title)}
          </a>
        ))}
      </section>
    ) : null}
    {post.slug === "franchise" ? (
      <figure class="franchise-cover">
        <video
          class="franchise-cover__motion"
          poster="/images/content/articles/franchise/cover.png"
          width="720"
          height="960"
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="Franchise magazine cover, animated"
        >
          <source src="/videos/franchise-cover.mp4" type="video/mp4" />
        </video>
        <img
          class="franchise-cover__still"
          src="/images/content/articles/franchise/cover.png"
          alt="Franchise magazine cover"
          width="1600"
          height="2133"
        />
        <button type="button" class="franchise-cover__pause" aria-pressed="false">Pause</button>
      </figure>
      <p class="franchise-cover__link"><a href="/mag/franchise">Magazine issue</a></p>
      <script is:inline>
        (function () {
          var root = document.querySelector(".franchise-cover");
          var video = root && root.querySelector("video");
          var button = root && root.querySelector(".franchise-cover__pause");
          if (!root || !video || !button) return;
          var reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
          function paint() {
            video.muted = true;
            if (reduce.matches) {
              video.pause();
              root.setAttribute("data-motion", "reduce");
              return;
            }
            root.setAttribute("data-motion", "play");
            var pending = video.play();
            if (pending && pending.catch) pending.catch(function () {});
            button.textContent = "Pause";
            button.setAttribute("aria-pressed", "false");
          }
          paint();
          if (reduce.addEventListener) reduce.addEventListener("change", paint);
          button.addEventListener("click", function () {
            if (reduce.matches) return;
            if (video.paused) {
              var pending = video.play();
              if (pending && pending.catch) pending.catch(function () {});
              button.textContent = "Pause";
              button.setAttribute("aria-pressed", "false");
            } else {
              video.pause();
              button.textContent = "Play";
              button.setAttribute("aria-pressed", "true");
            }
          });
        })();
      </script>
    ) : null}
  </article>
</Base>
