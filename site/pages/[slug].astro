---
import Base from "../layouts/Base.astro";
import {
  formatAuthorName,
  formatDate,
  getBlogPosts,
  getRelatedPosts,
  parseKeyPoint,
  reportHeadlineRest,
  reportKicker,
  sectionLabel,
} from "@/lib/content";
import { DOMAIN_META, SUBDOMAIN_META, primaryDomain, primarySubdomain } from "@/data/sections";
import downloads from "@/src/generated/downloads.json";
import { existsSync } from "node:fs";
import { readingMinutes, withStaticCharts } from "../lib/static-charts";
import ArtBarChart from "../components/preview/ArtBarChart.astro";
import ArticleDownloads from "../components/ArticleDownloads.astro";
import ChartCarousel from "../components/ChartCarousel.astro";
import KeyFigures from "../components/KeyFigures.astro";
import { articleBanner, chartSlides, shortLabel } from "../lib/article-page";
import { artworkDownloads } from "@/lib/article-assets.mjs";

export function getStaticPaths() {
  return getBlogPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const label = sectionLabel(post.tags, post.subject);
const kicker = reportKicker(post.title, post.subject);
const headlineRest = reportHeadlineRest(post.title);
const minutes = readingMinutes(post.body || "");
const author = post.author ? formatAuthorName(String(post.author)) : "Kyle McAuliffe";
const domain = primaryDomain(post.tags || []);
const sub = primarySubdomain(post.tags || []);
const audioFile = post.audioSrc && !String(post.audioSrc).startsWith("http")
  ? existsSync(new URL(`../../public${post.audioSrc}`, import.meta.url))
  : Boolean(post.audioSrc);
const pack = downloads[post.slug as keyof typeof downloads] as
  | {
      dataset?: string | null;
      pdf?: string | null;
      epub?: string | null;
      audio?: string | null;
      transcript?: string | null;
      html?: string | null;
    }
  | undefined;
const artwork = artworkDownloads(post.slug);
const related = getRelatedPosts(post.slug, 3);
const faq = (post.faq || []) as { question: string; answer: string }[];
const image = post.heroImage || "/images/brand/og-default.png";
const { html: anchoredBody, slides } = chartSlides(post.body || "");
const body = post.body || "";
const banner = articleBanner(post.slug);
const printCover = existsSync(new URL(`../../public/images/content/articles/${post.slug}/cover-title.webp`, import.meta.url))
  ? `/images/content/articles/${post.slug}/cover-title.webp`
  : "";
const embeddedFacts = body.includes('class="facts-grid"');
const points = embeddedFacts ? [] : ((post.keyPoints || []) as string[]);
const facts = points
  .map((point) => parseKeyPoint(String(point)))
  .filter((fact) => fact.value)
  .map((fact) => ({ value: fact.value, label: shortLabel(fact.label) }));
const factSource = /data-source="([^"]+)"/.exec(body)?.[1]
  ?.replace(/\s+[—-]\s+ARTOMETRICS\s*$/i, "")
  .trim() || "";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: post.title,
    description: post.description,
    datePublished: post.pubDate,
    image: [image.startsWith("http") ? image : `https://artometrics.com${image}`],
    author: { "@type": "Person", name: author },
    publisher: { "@type": "Organization", name: "Artometrics", url: "https://artometrics.com" },
    mainEntityOfPage: `https://artometrics.com/${post.slug}`,
    articleSection: label || DOMAIN_META[domain].title,
  },
  ...(faq.length
    ? [{
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      }]
    : []),
];
---

<Base
  title={post.title}
  description={post.description}
  path={`/${post.slug}`}
  image={image}
  type="article"
  jsonLd={jsonLd}
  footer="none"
  bodyClass="dash"
>
  <link slot="head" rel="stylesheet" href="/css/artometrics-article.css" />
  <link slot="head" rel="stylesheet" href="/css/astro-contrast.css" />
  <article class="preview-frame preview-report">
    {printCover ? (
      <figure class="print-cover" aria-hidden="true">
        <img src={printCover} alt="" width="900" height="1200" loading="lazy" />
      </figure>
    ) : null}
    {banner ? (
      <figure class="article-banner">
        <img src={banner.src} alt="" width={banner.width} height={banner.height} fetchpriority="high" />
      </figure>
    ) : null}
    <p class="preview-crumb">
      <a href="/#reports">Reports</a>
      <span aria-hidden="true"> · </span>
      <a href={`/topics/${domain}`}>{DOMAIN_META[domain].title}</a>
      {sub && SUBDOMAIN_META[sub] ? (
        <>
          <span aria-hidden="true"> · </span>
          <a href={`/topics/${domain}?sub=${sub}`}>{SUBDOMAIN_META[sub].title}</a>
        </>
      ) : null}
    </p>

    <div class="preview-report-top">
      <div>
        <h1>
          <span class="report-kicker">{kicker}:</span>
          {" "}{headlineRest}
        </h1>
        <p class="preview-dek">{post.description}</p>
        <ul class="preview-meta">
          {label ? <li>{label}</li> : null}
          <li>By {author}</li>
          {post.pubDate ? <li>{formatDate(post.pubDate)}</li> : null}
          <li>{minutes} min</li>
        </ul>
        {audioFile && post.audioSrc ? (
          <audio controls preload="none" src={post.audioSrc}>
            <a href={post.audioSrc}>Listen</a>
          </audio>
        ) : null}
      </div>
    </div>

    {facts.length ? <KeyFigures facts={facts} source={factSource} /> : null}
    <ChartCarousel slides={slides} />
    <ArticleDownloads slug={post.slug} pack={pack} artwork={artwork} />

    {post.slug === "longevity" ? (
      <section class="preview-panel" aria-labelledby="leaders-title">
        <h2 id="leaders-title">Top 12 countries by average life expectancy across all years</h2>
        <ArtBarChart labelledBy="leaders-title" />
      </section>
    ) : null}

    <div class="artometrics-article-body" set:html={withStaticCharts(anchoredBody)} />

    {related.length ? (
      <section class="report-related">
        <h2>Related</h2>
        {related.map((item) => (
          <a href={`/${item.slug}`}>
            <span class="report-kicker">{reportKicker(item.title, item.subject)}:</span>
            {" "}{reportHeadlineRest(item.title)}
          </a>
        ))}
      </section>
    ) : null}
    {post.slug === "franchise" ? (
      <figure class="franchise-cover">
        {pack?.pdf ? (
          <a href={pack.pdf} target="_blank" rel="noopener" aria-label="Open the Franchise PDF in a new tab">
            <img
              class="franchise-cover__still"
              src="/images/content/articles/franchise/cover-title.webp"
              alt="Franchise magazine cover"
              width="900"
              height="1200"
              loading="lazy"
            />
          </a>
        ) : (
          <img
            class="franchise-cover__still"
            src="/images/content/articles/franchise/cover-title.webp"
            alt="Franchise magazine cover"
            width="900"
            height="1200"
            loading="lazy"
          />
        )}
      </figure>
    ) : null}
  </article>
</Base>
