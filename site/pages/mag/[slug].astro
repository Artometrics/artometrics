---
import Mag from "../../layouts/Mag.astro";
import { issueJsonLd, magazineIssue, magazineIssues, renderIssueBody } from "@/lib/magazine";
import { skinsForIssue } from "@/lib/magazine-skins";

export function getStaticPaths() {
  return magazineIssues().map((issue) => ({ params: { slug: issue.slug } }));
}

const { slug } = Astro.params;
const issue = magazineIssue(slug);
if (!issue) throw new Error(`Missing magazine issue ${slug}`);
const skins = skinsForIssue(issue);
---

<Mag
  title={issue.title}
  description={issue.dek}
  path={`/mag/${issue.slug}`}
  pageKey={issue.slug}
  label={issue.kicker}
  bodyHtml={renderIssueBody(issue)}
  skins={skins}
  jsonLd={issueJsonLd(issue)}
/>
