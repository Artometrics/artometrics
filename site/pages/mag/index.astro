---
import Mag from "../../layouts/Mag.astro";
import { contentsJsonLd, magazineIssues, renderContentsBody } from "@/lib/magazine";
import { skinsForIssue } from "@/lib/magazine-skins";
import skinDefaults from "@/magazine/skin-defaults.json";

const issues = magazineIssues();
const skins = skinsForIssue({ skins: skinDefaults });
---

<Mag
  title="Artometrics Magazine — page-flip edition"
  description="Five-minute data stories in the page-flip reader. Choose a skin and swipe through the issue."
  path="/mag"
  pageKey="contents"
  label="Contents"
  bodyHtml={renderContentsBody(issues)}
  skins={skins}
  jsonLd={contentsJsonLd(issues)}
/>
