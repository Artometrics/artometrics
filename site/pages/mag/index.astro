---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import BannerCarousel from "../../components/BannerCarousel.astro";
import { EDITIONS } from "@/data/editions";
import { DOMAIN_META, type DomainSlug } from "@/data/sections";
import { getBlogPost, getBlogPosts } from "@/lib/content";
import { magazineIssues } from "@/lib/magazine";

const issues = magazineIssues();
const featureSlugs = ["franchise", "anime", "padres"];
const featurePosts = featureSlugs.flatMap((slug) => {
  const post = getBlogPost(slug);
  return post && issues.some((issue) => issue.slug === slug) ? [post] : [];
});
const desks = (["arts", "sports", "science", "humanities", "civics", "culture"] as DomainSlug[])
  .map((id) => ({
    id,
    label: DOMAIN_META[id].title,
    issues: issues.filter((issue) => (issue.tags || []).includes(id)),
  }))
  .filter((desk) => desk.issues.length);
const editions = EDITIONS.filter((edition) => {
  if (!edition.heroImage) return false;
  return existsSync(join(process.cwd(), "public", edition.heroImage.replace(/^\//, "")));
}).map((edition) => ({
  ...edition,
  live: edition.articleSlugs.filter((slug) => getBlogPosts().some((post) => post.slug === slug)).length,
}));
---

<Base
  title="Magazine"
  description="The Artometrics magazine: a featured issue, desks, and special editions."
  path="/mag"
>
  <div class="desk-home">
    <p class="desk-lead__kicker">Magazine</p>
    <h1 class="desk-page-title">Magazine</h1>
    <p class="desk-page-dek">{issues.length} issues in the page-flip reader. Open an issue, or read the report.</p>
    <BannerCarousel
      posts={featurePosts}
      label="Featured issues"
      hrefFor={(post) => `/mag/${post.slug}`}
    />
    {desks.map((desk) => (
      <section class="desk-section">
        <h2><a href={`/topics/${desk.id}`}>{desk.label}</a></h2>
        <div class="story-grid">
          {desk.issues.map((issue) => (
            <a class="story-tile" href={`/mag/${issue.slug}`}>
              <img src={issue.hero} alt={`${issue.kicker}: ${issue.title}`} width="800" height="800" />
            </a>
          ))}
        </div>
      </section>
    ))}
    <h2 class="desk-page-title">Editions</h2>
    <div class="story-grid">
      {editions.map((edition) => (
        <a class="mag-edition" href={`/editions/${edition.id}`}>
          <img src={edition.heroImage} alt="" width="800" height="450" />
          <strong>{edition.title}</strong>
          <span>{edition.status} · {edition.live} live reports</span>
        </a>
      ))}
    </div>
  </div>
</Base>
