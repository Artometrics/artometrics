---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="That page is not on Artometrics." path="/404">
  <div class="wrap wrap--narrow page">
    <p class="kicker">404</p>
    <h1>Not on the desk</h1>
    <p class="lede">The address does not match a report or section.</p>
    <p><a class="btn" href="/">Front page</a> <a class="btn btn--ghost" href="/blog">All reports</a></p>
  </div>
</Base>
