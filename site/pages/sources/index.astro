---
import Base from "../../layouts/Base.astro";
import catalog from "@/src/generated/sources.json";

const topics = catalog.topics;
const reportCount = topics.reduce((sum, topic) => sum + topic.issues.length, 0);
---

<Base
  title="Sources"
  description="Citations behind Artometrics reports, grouped by topic, with the date each file runs through."
  path="/sources"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Artometrics sources",
    url: "https://artometrics.com/sources",
  }}
>
  <div class="wrap page">
    <p class="kicker">Citations</p>
    <h1>Sources</h1>
    <p class="lede">{reportCount} reports, grouped by desk. Each citation keeps the wording from the issue file.</p>
    <nav class="filters" aria-label="Topics">
      {topics.map((topic) => <a href={`#${topic.id}`}>{topic.title}</a>)}
    </nav>
    {topics.map((topic) => (
      <section class="source-block" id={topic.id}>
        <h2><a href={topic.href}>{topic.title}</a></h2>
        <p class="lede">{topic.description}</p>
        {topic.issues.map((issue) => (
          <article>
            <h3><a href={issue.href}>{issue.title}</a></h3>
            <p class="meta">{issue.kicker} · {issue.updatedThrough}</p>
            {issue.datasets?.length ? (
              <p>
                Dataset{" "}
                {issue.datasets.map((dataset, index) => (
                  <>
                    {index ? ", " : null}
                    <a href={dataset.href}>{dataset.title}</a>
                  </>
                ))}
              </p>
            ) : null}
            <ul>
              {issue.citations.map((citation) => (
                <li>
                  {citation.href ? (
                    <a href={citation.href}>{citation.text || citation.href}</a>
                  ) : (
                    <>
                      {citation.text || "Untitled citation"} <span class="kicker">no link yet</span>
                    </>
                  )}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </section>
    ))}
  </div>
</Base>
