---
import "../styles/site.css";
import "../styles/preview.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { existsSync } from "node:fs";
import { join } from "node:path";
import { jsonForScript } from "../lib/static-charts";
import { getBlogPosts, sectionLabel } from "@/lib/content";
import { LOGO_REVIEW, WORDMARKS, type LogoReviewMark } from "@/lib/wordmarks";
import { DOMAIN_META, DOMAIN_SLUGS, SUBDOMAIN_META, SUBDOMAIN_SLUGS } from "@/data/sections";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: unknown;
  footer?: "home" | "article" | "site" | "none";
  robots?: string;
  headerVariant?: "site" | "preview";
  showSocial?: boolean;
  bodyClass?: string;
  /** Review routes only. Live pages leave this unset and keep the white default. */
  logoReview?: LogoReviewMark;
}

const {
  title,
  description,
  path,
  image = "/images/brand/og-default.png",
  type = "website",
  jsonLd,
  footer = "site",
  robots = "index, follow",
  headerVariant = "site",
  showSocial = false,
  bodyClass = "",
  logoReview,
} = Astro.props;

const review = logoReview ? LOGO_REVIEW[logoReview] : null;
const monograms = Object.fromEntries(
  WORDMARKS.map((mark) => [
    mark.id,
    { night: mark.monoNight, day: mark.monoDay, appleNight: mark.appleNight, appleDay: mark.appleDay },
  ]),
);
const robotsOut = review ? "noindex, nofollow" : robots;

const SITE = "https://artometrics.com";
const fullTitle = title.includes("Artometrics") ? title : `${title} · Artometrics`;
const url = `${SITE}${path.startsWith("/") ? path : `/${path}`}`;
const img = image.startsWith("http") ? image : `${SITE}${image}`;
function reportThumb(slug: string) {
  const square = join(process.cwd(), "public/images/content/articles", slug, "square-art.webp");
  if (existsSync(square)) return `/images/content/articles/${slug}/square-art.webp`;
  const banner = join(process.cwd(), "public/images/content/articles", slug, "banner-art.webp");
  if (existsSync(banner)) return `/images/content/articles/${slug}/banner-art.webp`;
  return "";
}
const navIndex = [
  ...DOMAIN_SLUGS.map((slug) => ({
    kind: "topic",
    title: DOMAIN_META[slug].title,
    href: `/topics/${slug}`,
    meta: "Section",
    blob: `${DOMAIN_META[slug].title} ${slug} ${DOMAIN_META[slug].description}`.toLowerCase(),
  })),
  ...SUBDOMAIN_SLUGS.map((slug) => ({
    kind: "topic",
    title: SUBDOMAIN_META[slug].title,
    href: `/blog?subdomain=${slug}`,
    meta: "Topic",
    blob: `${SUBDOMAIN_META[slug].title} ${slug}`.toLowerCase(),
  })),
  ...getBlogPosts().map((post) => ({
    kind: "report",
    title: post.title,
    href: `/${post.slug}`,
    meta: sectionLabel(post.tags, post.subject) || "Report",
    image: reportThumb(post.slug) || post.heroImage || "",
    blob: `${post.title} ${post.slug} ${(post.tags || []).join(" ")}`.toLowerCase(),
  })),
];
---

<!doctype html>
<html
    lang="en"
    data-theme="dark"
    data-logo={review?.catalogId ?? "halftone"}
    data-logo-form="wordmark"
    {...(review ? { "data-logo-review": review.id } : {})}
  >
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          if (root.getAttribute("data-logo-review")) {
            root.setAttribute("data-theme", "dark");
            root.style.colorScheme = "dark";
            return;
          }
          var theme = localStorage.getItem("artometrics-theme");
          var logo = localStorage.getItem("artometrics-logo");
          var form = localStorage.getItem("artometrics-logo-form");
          var allowed = { white: 1, svg: 1, halftone: 1, d01: 1, d02: 1, d03: 1, d04: 1, d05: 1, d06: 1, d07: 1, d08: 1 };
          if (theme !== "light") theme = "dark";
          if (!allowed[logo]) logo = "halftone";
          if (form !== "single") form = "wordmark";
          root.setAttribute("data-theme", theme);
          root.setAttribute("data-logo", logo);
          root.setAttribute("data-logo-form", form);
          root.style.colorScheme = theme === "light" ? "light" : "dark";
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsOut} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={img} />
    <meta property="og:site_name" content="Artometrics" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@artometrics" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={img} />
    <link id="site-favicon" rel="icon" type="image/png" sizes="32x32" href={monograms.halftone.night} />
    <link id="site-apple" rel="apple-touch-icon" href={monograms.halftone.appleNight} />
    <script type="application/json" id="mono-map" set:html={jsonForScript(monograms)} />
    <script is:inline>
      (function () {
        var node = document.getElementById("mono-map");
        var map = node ? JSON.parse(node.textContent || "{}") : {};
        var root = document.documentElement;
        var id = root.getAttribute("data-logo") || "halftone";
        var hit = map[id] || map.white;
        if (!hit) return;
        var dark = root.getAttribute("data-theme") !== "light";
        var icon = document.getElementById("site-favicon");
        var apple = document.getElementById("site-apple");
        if (icon) icon.href = dark ? hit.night : hit.day;
        if (apple) apple.href = dark ? hit.appleNight : hit.appleDay;
      })();
    </script>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Artometrics reports" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Artometrics podcast" href="/podcast.xml" />
    <link rel="stylesheet" href="/css/house-style.css" />
    <slot name="head" />
    {jsonLd ? <script type="application/ld+json" set:html={jsonForScript(jsonLd)} /> : null}
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <Header variant={headerVariant} logoReview={logoReview} />
    <main id="main">
      <slot />
    </main>
    {footer === "none" ? null : <Footer variant={footer} showSocial={showSocial} />}
    <script type="application/json" id="nav-index" set:html={jsonForScript(navIndex)} />
    <script>
      const indexNode = document.getElementById("nav-index");
      const index = indexNode ? JSON.parse(indexNode.textContent || "[]") : [];
      const overlay = document.getElementById("nav-overlay");
      const openBtn = document.getElementById("open-menu");
      const closeBtn = document.getElementById("close-menu");
      const search = document.getElementById("nav-search");
      const suggest = document.getElementById("nav-suggest");
      const factLink = document.getElementById("fact-link");
      const factText = document.getElementById("fact-text");
      const factSource = document.getElementById("fact-source");
      const factsNode = document.getElementById("nav-facts");
      const facts = factsNode ? JSON.parse(factsNode.textContent || "[]") : [];
      let lastFact = -1;

      function showFact() {
        if (!facts.length || !factLink || !factText || !factSource) return;
        let idx = Math.floor(Math.random() * facts.length);
        if (facts.length > 1 && idx === lastFact) idx = (idx + 1) % facts.length;
        lastFact = idx;
        const fact = facts[idx];
        factText.textContent = fact.text;
        factLink.href = `/${fact.slug}`;
        factLink.setAttribute("aria-label", `${fact.text}. ${fact.title}`);
        factSource.href = fact.sourceHref;
        factSource.textContent = `Source · ${fact.sourceLabel}`;
      }

      function placeOverlay() {
        if (!overlay || overlay.hidden) return;
        const viewport = window.visualViewport;
        if (!viewport) return;
        const keyboard = window.innerHeight - viewport.height > 120;
        overlay.classList.toggle("nav-overlay--keyboard", keyboard);
        overlay.style.top = `${viewport.offsetTop}px`;
        overlay.style.height = `${viewport.height}px`;
      }
      function openMenu() {
        if (!overlay) return;
        overlay.hidden = false;
        document.body.style.overflow = "hidden";
        showFact();
        placeOverlay();
        search?.focus();
      }
      function closeMenu() {
        if (!overlay) return;
        overlay.hidden = true;
        overlay.classList.remove("nav-overlay--keyboard");
        overlay.style.top = "";
        overlay.style.height = "";
        document.body.style.overflow = "";
        openBtn?.focus();
      }
      window.visualViewport?.addEventListener("resize", placeOverlay);
      window.visualViewport?.addEventListener("scroll", placeOverlay);
      openBtn?.addEventListener("click", openMenu);
      closeBtn?.addEventListener("click", closeMenu);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && overlay && !overlay.hidden) closeMenu();
      });

      function renderSuggest(query) {
        if (!suggest) return;
        const q = query.trim().toLowerCase();
        suggest.replaceChildren();
        if (q.length < 1) return;
        const tokens = q.split(/\s+/).filter(Boolean);
        const hits = index
          .map((item) => {
            const blob = item.blob || "";
            let score = 0;
            for (const token of tokens) if (blob.includes(token)) score += 1;
            if (item.title.toLowerCase().startsWith(q)) score += 2;
            return { item, score };
          })
          .filter((row) => row.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 8);
        for (const { item } of hits) {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = item.href;
          const small = document.createElement("small");
          small.textContent = item.meta || item.kind;
          const strong = document.createElement("strong");
          strong.textContent = item.title;
          if (item.kind === "report" && item.image) {
            const img = document.createElement("img");
            img.src = item.image;
            img.alt = "";
            img.width = 64;
            img.height = 64;
            a.append(img);
          }
          const copy = document.createElement("span");
          copy.append(small, strong);
          a.append(copy);
          li.append(a);
          suggest.append(li);
        }
      }
      search?.addEventListener("input", () => renderSuggest(search.value));
      document.getElementById("nav-clear")?.addEventListener("click", () => {
        if (!search) return;
        search.value = "";
        renderSuggest("");
        search.focus();
      });
      search?.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") return;
        const q = search.value.trim();
        if (q.length < 2) return;
        location.href = `/search?q=${encodeURIComponent(q)}`;
      });
    </script>
  </body>
</html>
