---
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  catalog?: boolean;
}

const { title, description, path, catalog = false } = Astro.props;
---

<Base
  title={title}
  description={description}
  path={path}
  robots="noindex, nofollow"
  headerVariant="preview"
  showSocial
  bodyClass={catalog ? "dash catalog-preview" : "dash"}
  footer="site"
>
  <slot />
</Base>
