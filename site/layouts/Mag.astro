---
import { jsonForScript } from "../lib/static-charts";
import { skinCssVars, type MagSkin } from "@/lib/magazine-skins";

interface Props {
  title: string;
  description: string;
  path: string;
  pageKey: string;
  label: string;
  bodyHtml: string;
  skins: MagSkin[];
  jsonLd?: unknown;
}

const { title, description, path, pageKey, label, bodyHtml, skins, jsonLd } = Astro.props;
const SITE = "https://artometrics.com";
const fullTitle = title.includes("Artometrics") ? title : `${title} · Artometrics`;
const url = `${SITE}${path}`;
const skin = skins[0];
const shortSkin: Record<string, string> = {
  ledger: "Ledger",
  box: "Box",
  trade: "Trade",
  chart: "Chart",
  sleeve: "Sleeve",
  stream: "Stream",
  shelf: "Shelf",
  guide: "Guide",
  late: "Late",
  filing: "File",
  gauge: "Gauge",
  onair: "Air",
};
function cssDecl(key: string): string {
  return key.startsWith("--") ? key : key.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`);
}
function styleText(vars: Record<string, string> | undefined): string {
  if (!vars) return "";
  return Object.entries(vars)
    .map(([key, value]) => `${cssDecl(key)}:${value}`)
    .join(";");
}
const style = styleText(skin ? skinCssVars(skin) : undefined);
const exitHref = pageKey === "contents" ? "/blog" : `/${pageKey}`;
const payload = skins.map((item) => ({ id: item.id, name: item.name, vars: skinCssVars(item) }));
---

<!doctype html>
<html lang="en" class="mag-mode" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={`${SITE}/images/brand/og-default.png`} />
    <meta property="og:site_name" content="Artometrics" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/css/mag.css" />
    <link rel="stylesheet" href="/css/mag-skins.css" />
    <style>
      .skip { position: absolute; left: 8px; top: -48px; z-index: 100; background: #f3ead7; color: #100e0c; padding: 8px 12px; }
      .skip:focus { top: 8px; }
    </style>
    {jsonLd ? <script type="application/ld+json" set:html={jsonForScript(jsonLd)} /> : null}
  </head>
  <body>
    <a class="skip" href="#book">Skip to issue</a>
    <div class="mag-shell" data-magazine={pageKey} data-skin={skin?.id} style={style}>
      <header class="bar">
        <a href="/mag" aria-label="Contents"><img src="/images/brand/chomsky-a-white.png" alt="" width="22" height="22" /></a>
        <span class="t">{label}</span>
        <div class="skin-picker" role="radiogroup" aria-label="Magazine skin">
          {skins.map((item, index) => (
            <button type="button" role="radio" aria-checked={index === 0 ? "true" : "false"} aria-label={item.name} data-skin-id={item.id}>
              <span class="skin-label">{shortSkin[item.id] || item.name.split(" ")[0]}</span>
              <span class="tip">{item.name}</span>
            </button>
          ))}
        </div>
        <a class="site" href={exitHref}>Exit to article</a>
        <span id="pg" aria-live="polite">1</span>
      </header>
      <div id="view">
        <div id="fold"></div>
        <article id="book" itemscope itemtype="https://schema.org/Article" set:html={bodyHtml} />
      </div>
      <footer class="bar">
        <span aria-hidden="true">←</span>
        <div class="prog"><i id="bar"></i></div>
        <span aria-hidden="true">→</span>
        <span id="tot"></span>
      </footer>
      <div class="hint" id="hint">Swipe sideways to turn. Scroll the page to read.</div>
    </div>
    <script type="application/json" id="mag-skins" set:html={jsonForScript(payload)} />
    <script>
      const skins = JSON.parse(document.getElementById("mag-skins")?.textContent || "[]");
      const shell = document.querySelector(".mag-shell");
      function cssName(key) {
        return key.startsWith("--") ? key : key.replace(/[A-Z]/g, (letter) => "-" + letter.toLowerCase());
      }
      function apply(id) {
        const skin = skins.find((item) => item.id === id) || skins[0];
        if (!skin || !shell) return;
        shell.dataset.skin = skin.id;
        for (const [key, value] of Object.entries(skin.vars || {})) {
          shell.style.setProperty(cssName(key), value);
        }
        document.querySelectorAll("[data-skin-id]").forEach((button) => {
          button.setAttribute("aria-checked", button.getAttribute("data-skin-id") === skin.id ? "true" : "false");
        });
        const pageKey = shell.getAttribute("data-magazine") || "contents";
        try { localStorage.setItem(`artometrics-mag-skin:${pageKey}`, skin.id); } catch { /* private mode */ }
        const url = new URL(location.href);
        if (!skins[0] || skin.id === skins[0].id) url.searchParams.delete("skin");
        else url.searchParams.set("skin", skin.id);
        history.replaceState(null, "", url.pathname + url.search + url.hash);
        window.ArtometricsMag?.boot?.();
      }
      const pageKey = shell?.getAttribute("data-magazine") || "contents";
      let saved = null;
      try { saved = localStorage.getItem(`artometrics-mag-skin:${pageKey}`); } catch { saved = null; }
      const asked = new URLSearchParams(location.search).get("skin");
      const initial = asked || saved;
      if (initial && skins.some((item) => item.id === initial)) apply(initial);
      function start() { window.ArtometricsMag?.boot?.(); }
      if (window.ArtometricsMag) start();
      else {
        const script = document.createElement("script");
        script.src = "/mag.js";
        script.onload = start;
        document.body.appendChild(script);
      }
      document.querySelectorAll("[data-skin-id]").forEach((button) => {
        button.addEventListener("click", (event) => {
          event.stopPropagation();
          apply(button.getAttribute("data-skin-id"));
        });
      });
    </script>
  </body>
</html>
