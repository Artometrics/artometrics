    "test:charts": "node scripts/test-charts-smoke.mjs",
    "test:smoke": "node scripts/test-site-smoke.mjs",
    "test:ops-scripts": "node scripts/test-ops-scripts.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "eas:build:ios": "node scripts/run-eas-build.mjs",
    "eas:build:preview": "npx eas-cli build -p ios --profile preview",
    "eas:submit:ios": "node scripts/run-eas-submit.mjs"
